{
  "_comment": "复制为 envs.json。服务端配置：password/api_key 只能写 env:<变量名>（值放 deploy/.env）；keychain: 仅 macOS 本机可用，服务器上不要用。",
  "default_env": "test",
  "environments": [
    {
      "env": "test",
      "url": "http://kibana-test.example.com",
      "mode": "kibana",
      "index": "app-test-*",
      "username": "log_reader",
      "password": "env:ELK_TEST_PASSWORD",
      "default": true
    },
    {
      "env": "stag",
      "url": "http://kibana-test.example.com",
      "mode": "kibana",
      "index": "app-staging-*",
      "username": "log_reader",
      "password": "env:ELK_TEST_PASSWORD"
    },
    {
      "env": "prod",
      "url": "http://kibana.example.com",
      "mode": "kibana",
      "index": "app-prod-*",
      "username": "log_reader",
      "password": "env:ELK_PROD_PASSWORD",
      "aliases": ["生产", "线上"],
      "production": true,
      "max_size": 2000
    }
  ]
}
