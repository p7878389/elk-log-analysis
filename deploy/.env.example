# 复制为 .env 后填写；.env 含密码与 token，勿提交 git，建议 chmod 600
# 全部配置都用环境变量：compose 用 env_file 传给容器，修改后执行 ./docker-up.sh（或 docker compose up -d）生效。
# 仍可改用 config/ 下的文件（envs.json、tokens.json）；同时存在时环境变量优先，tokens 两者合并。

# ---- Docker Compose（docker compose 启动时读取；docker-up 脚本的 --image/--load/--tls/--publish 会写到这里）----
# 镜像：由源码仓库 deploy/build-image.sh 构建，部署包里的模板已预填本次构建的镜像。推送到镜像仓库时写完整地址
# ELK_IMAGE=elk-mcp:latest
# 宿主机监听地址：默认 127.0.0.1:8765（只给本机反向代理）；内网直连写 8765（监听所有网卡）
# ELK_HTTP_PUBLISH=127.0.0.1:8765
# 同时启动 Caddy 自动 HTTPS
# COMPOSE_PROFILES=tls
# 从旧版（源码仓库 deploy 目录内 docker compose up --build）迁移、想沿用原有数据卷时取消注释
# COMPOSE_PROJECT_NAME=deploy

# ---- 存储目录（宿主机）----
# 默认用 Docker 数据卷（elk-mcp_<名称>）；写宿主机绝对路径则改用该目录，docker-up.sh 会创建，elk-mcp 读写的目录授权给 uid 10001。
# 改目录后原数据卷里的内容不会自动迁移：仓库会重新同步、gitnexus 会重新安装、索引会重新构建。
# 代码仓库：GitLab clone 下来的仓库（部分 clone，容器内 /repos）
# ELK_REPOS_DIR=/srv/elk-mcp/repos
# 数据：cache/worktrees 下的分支只读副本与 GitNexus 索引（每个仓库约 0.5G，占用最大）、同步与索引日志、调用日志、索引登记表（容器内 /data）
# ELK_DATA_DIR=/srv/elk-mcp/data
# gitnexus 程序：gitnexus-install 安装的 node + gitnexus（约 300MB，容器内 /opt/gitnexus）
# ELK_GITNEXUS_TOOLS_DIR=/srv/elk-mcp/gitnexus-tools
# Caddy 自动申请的 HTTPS 证书（--tls 时）
# ELK_CADDY_DIR=/srv/elk-mcp/caddy

# ---- ELK 环境 ----
# 环境列表与默认环境；每个环境的变量前缀为 ELK_<环境名大写>_，不写的项回落到全局 ELK_<KEY>
ELK_ENVS=test,prod
ELK_DEFAULT_ENV=test
# mode：kibana（经 Kibana Console 代理）或 es（直连 Elasticsearch）
ELK_MODE=kibana
ELK_TEST_URL=http://kibana-test.example.com
ELK_TEST_INDEX=app-test-*
ELK_TEST_USERNAME=log_reader
ELK_TEST_PASSWORD=
ELK_PROD_URL=http://kibana.example.com
ELK_PROD_INDEX=app-prod-*
ELK_PROD_USERNAME=log_reader
ELK_PROD_PASSWORD=
# 生产保护按环境名识别（prod/生产），也可显式指定；单次返回条数上限
ELK_PROD_PRODUCTION=true
ELK_PROD_ALIASES=生产,线上
ELK_PROD_MAX_SIZE=2000
# 其他可选项：ELK_<ENV>_API_KEY、_VERIFY_SSL、_CA_CERT、_KIBANA_SPACE、_PROXY、_TIMEOUT、_BRANCH、_SERVICE_MAP 等，
# 字段名映射用 ELK_FIELDS={"trace":"traceId"}；完整说明见 references/mcp-config.md
# 也可以把所有环境写成一个 JSON 数组（设置后 ELK_ENVS 与 ELK_<ENV>_* 不再生效）：
# ELK_ENVIRONMENTS=[{"env":"test","url":"http://kibana-test.example.com","mode":"kibana","index":"app-test-*","username":"log_reader","password":"xxx","default":true}]

# ---- 访问 MCP 的成员 token ----
# JSON 数组，每个成员一项，只存 sha256（由 gen-token 生成，见 README 第 2 节）。首次运行 docker-up.sh 会自动生成管理员 token 写到这里
# prod=true 才能查生产；admin=true 才能执行修复与手动同步；code=false 禁止查看源码；disabled=true 临时停用
# 修改后需 ./docker-up.sh（或 docker compose up -d）重建容器生效；需要不重启增删成员时改用 config/tokens.json
# ELK_HTTP_TOKENS=[{"name":"admin","sha256":"<gen-token 输出的 sha256>","prod":true,"admin":true},{"name":"alice","sha256":"<…>"}]

# ---- HTTP 服务 ----
# 全局禁用的工具（逗号分隔）。留空表示全部启用
ELK_HTTP_DISABLED_TOOLS=
# 仅当浏览器类客户端需要跨域访问时填写，如 https://foo.example.com
ELK_HTTP_ALLOWED_ORIGINS=
# 不用 Caddy、由服务直接提供 HTTPS 时填写（路径是容器内路径，证书放 config 目录即可）
# ELK_HTTP_CERT=/config/tls.crt
# ELK_HTTP_KEY=/config/tls.key

# ---- Caddy（--profile tls）----
ELK_DOMAIN=elk-mcp.example.com

# ---- gitnexus（code_* 源码定位与服务端 GitNexus）----
# 服务器上不需要预装 node / gitnexus：docker-compose.yml 的 gitnexus-install 用官方 node 镜像把它们装进数据卷
# elk-mcp_gitnexus-tools，elk-mcp 只读挂载。版本没变时启动直接跳过；改版本后运行 ./docker-up.sh 会安装并重启 elk-mcp
# ELK_GITNEXUS_VERSION=1.6.12
# 访问不了 Docker Hub / npmjs 时换成镜像源（内网可指向内部仓库）
# ELK_NODE_IMAGE=node:22-bookworm
# ELK_NPM_REGISTRY=https://registry.npmmirror.com

# ---- GitLab 仓库定时同步 ----
# 建议用专门的服务账号，只加入团队需要排查的项目组（见 README 第 4 节）
# ELK_GITLAB_URL=https://gitlab.example.com
#
# 认证方式（ELK_GITLAB_AUTH 可不写，按填了哪种凭据自动判断）：
# ⓪ 什么都不填 = 自动检测：API 用本机 git 凭据管理器里已保存的该 GitLab 账号；
#    拉代码先试本机 SSH（~/.ssh、ssh-agent），不通再用 HTTPS。只读取，不修改钥匙串 / ~/.ssh。
#    适合原生部署在自己的电脑上；Docker 容器里默认看不到宿主机的 SSH 和凭据管理器，请用下面的显式配置
# ① 访问令牌（推荐）：个人 / 组 / 项目令牌，权限 read_api + read_repository
# ELK_GITLAB_TOKEN=glpat-xxxxxxxx
# ② 账号密码：经 OAuth 密码模式换取临时令牌，自动续期。开启了双因素认证或只能 SSO 登录的账号不可用
# ELK_GITLAB_USERNAME=elk-bot
# ELK_GITLAB_PASSWORD=xxxxxxxx
#   GitLab 要求 OAuth 应用时再填（管理员在 Admin → Applications 创建，勾选 read_api、read_repository）
# ELK_GITLAB_CLIENT_ID=
# ELK_GITLAB_CLIENT_SECRET=
# ③ OAuth 令牌（由外部系统签发并负责续期）
# ELK_GITLAB_AUTH=oauth
# ELK_GITLAB_TOKEN=xxxxxxxx
#
# 凭据也可以放在文件里（兼容 Docker secrets），变量名加 _FILE，例如：
# ELK_GITLAB_PASSWORD_FILE=/config/gitlab-password
#
# 拉取代码的协议：默认 auto（SSH 优先，不通再用 HTTPS）；可固定为 ssh 或 https。
# SSH 只能拉代码，列项目的 API 仍需上面的令牌或账号密码。容器内用 SSH 时需提供私钥：
# ELK_GITLAB_GIT_PROTOCOL=ssh
# ELK_GITLAB_SSH_KEY=/config/gitlab_ed25519
# 只同步这些组（含子组），不设则同步令牌账号是成员的全部项目
# ELK_GITLAB_GROUPS=backend,platform/services
# ELK_GITLAB_EXCLUDE=sandbox/*,*/docs
# 内部 CA 签发的 GitLab 证书（放在 config 目录）
# ELK_GITLAB_CA_CERT=/config/gitlab-ca.crt
# 同步间隔（秒），默认 6 小时；0 为仅手动（管理员用 code_repos sync=true 触发）
# ELK_REPO_SYNC_INTERVAL=21600
# 同步后为这些环境的分支预建 GitNexus 索引（每个仓库约 0.5G）；可用 ELK_REPO_SYNC_INDEX_REPOS 限定仓库
# ELK_REPO_SYNC_INDEX=prod
# ELK_REPO_SYNC_INDEX_REPOS=*-service,order-*
# 已有分支 worktree（近期 code_prepare 用过的仓库/分支）多久推进到远程最新并增量更新索引（秒），默认 30 分钟；0 关闭
# 每次仓库同步结束后也会刷新一次；使用中（ELK_CODE_LEASE 内）的 worktree 不推进
# ELK_CODE_REFRESH_INTERVAL=1800

# ---- code_* ----
# 服务名 → 仓库/模块 的映射等，与本地用法相同
# ELK_CODE_SERVICE_MAP={"crm":"acme-crm-manager"}

# ---- 原生部署（不用 Docker）时取消注释；相对路径按本文件所在目录解析 ----
# Docker 部署不要打开这几行，会覆盖镜像内的路径（容器内数据目录固定为 /data、/repos，宿主机位置用上面的 ELK_DATA_DIR / ELK_REPOS_DIR）
# ELK_HTTP_HOST=0.0.0.0
# ELK_HTTP_PORT=8765
# ELK_CONFIG=config/envs.json
# ELK_HTTP_TOKENS_FILE=config/tokens.json
# ELK_CODE_CACHE=data/cache
# ELK_CODE_ROOT=/srv/repos
