# 复制为 .env 后填写；.env 含密码，勿提交 git，建议 chmod 600

# ---- ELK 凭据（config/envs.json 中以 env:变量名 引用）----
ELK_TEST_PASSWORD=
ELK_PROD_PASSWORD=

# ---- HTTP 服务 ----
# 全局禁用的工具（逗号分隔）。base 镜像没有 gitnexus 时可禁用 code_prepare
ELK_HTTP_DISABLED_TOOLS=
# 仅当浏览器类客户端需要跨域访问时填写，如 https://foo.example.com
ELK_HTTP_ALLOWED_ORIGINS=
# 不用 Caddy、由服务直接提供 HTTPS 时填写（路径是容器内路径，证书放 config 目录即可）
# ELK_HTTP_CERT=/config/tls.crt
# ELK_HTTP_KEY=/config/tls.key

# ---- Caddy（--profile tls）----
ELK_DOMAIN=elk-mcp.example.com

# ---- GitLab 仓库定时同步（ELK_IMAGE_TARGET=code 时）----
# 建议用专门的服务账号，只加入团队需要排查的项目组（见 README 第 4 节）
# ELK_GITLAB_URL=https://gitlab.example.com
#
# 认证方式（ELK_GITLAB_AUTH 可不写，按填了哪种凭据自动判断）：
# ⓪ 什么都不填 = 自动检测：API 用本机 git 凭据管理器里已保存的该 GitLab 账号；
#    拉代码先试本机 SSH（~/.ssh、ssh-agent），不通再用 HTTPS。只读取，不修改钥匙串 / ~/.ssh。
#    适合原生部署在自己的电脑上；Docker 容器里默认看不到宿主机的 SSH 和凭据管理器，请用下面的显式配置
# ① 访问令牌（推荐）：个人 / 组 / 项目令牌，权限 read_api + read_repository
# ELK_GITLAB_TOKEN=glpat-xxxxxxxx
# ② 账号密码：经 OAuth 密码模式换取临时令牌，自动续期。开启了双因素认证或只能 SSO 登录的账号不可用
# ELK_GITLAB_USERNAME=elk-bot
# ELK_GITLAB_PASSWORD=xxxxxxxx
#   GitLab 要求 OAuth 应用时再填（管理员在 Admin → Applications 创建，勾选 read_api、read_repository）
# ELK_GITLAB_CLIENT_ID=
# ELK_GITLAB_CLIENT_SECRET=
# ③ OAuth 令牌（由外部系统签发并负责续期）
# ELK_GITLAB_AUTH=oauth
# ELK_GITLAB_TOKEN=xxxxxxxx
#
# 凭据也可以放在文件里（兼容 Docker secrets），变量名加 _FILE，例如：
# ELK_GITLAB_PASSWORD_FILE=/config/gitlab-password
#
# 拉取代码的协议：默认 auto（SSH 优先，不通再用 HTTPS）；可固定为 ssh 或 https。
# SSH 只能拉代码，列项目的 API 仍需上面的令牌或账号密码。容器内用 SSH 时需提供私钥：
# ELK_GITLAB_GIT_PROTOCOL=ssh
# ELK_GITLAB_SSH_KEY=/config/gitlab_ed25519
# 只同步这些组（含子组），不设则同步令牌账号是成员的全部项目
# ELK_GITLAB_GROUPS=backend,platform/services
# ELK_GITLAB_EXCLUDE=sandbox/*,*/docs
# 内部 CA 签发的 GitLab 证书（放在 config 目录）
# ELK_GITLAB_CA_CERT=/config/gitlab-ca.crt
# 同步间隔（秒），默认 6 小时；0 为仅手动（管理员用 code_repos sync=true 触发）
# ELK_REPO_SYNC_INTERVAL=21600
# 同步后为这些环境的分支预建 GitNexus 索引（每个仓库约 0.5G）；可用 ELK_REPO_SYNC_INDEX_REPOS 限定仓库
# ELK_REPO_SYNC_INDEX=prod
# ELK_REPO_SYNC_INDEX_REPOS=*-service,order-*

# ---- code_*（ELK_IMAGE_TARGET=code 时）----
# 服务名 → 仓库/模块 的映射等，与本地用法相同
# ELK_CODE_SERVICE_MAP={"crm":"acme-crm-manager"}

# ---- 原生部署（不用 Docker）时取消注释；相对路径按本文件所在目录解析 ----
# Docker 部署不要打开这几行，会覆盖镜像内的 /config 路径
# ELK_HTTP_HOST=0.0.0.0
# ELK_HTTP_PORT=8765
# ELK_CONFIG=config/envs.json
# ELK_HTTP_TOKENS_FILE=config/tokens.json
# ELK_CODE_CACHE=data/cache
# ELK_CODE_ROOT=/srv/repos
